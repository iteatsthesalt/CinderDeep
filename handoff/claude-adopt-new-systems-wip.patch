index 0000000..31489ec
--- /dev/null
+++ b/projects/cinderdeep-3d/jobs/lib/browser.mjs
@@ -0,0 +1,138 @@
+// Browser plumbing shared by the jobs' tools: open the game with ?debug, start a life, walk the floor map,
+// take screenshots and lay them out on one contact sheet. Needs Playwright and a running dev server
+// (npx vite --port 5199 --strictPort). In a Claude Code cloud session run tools with NODE_PATH=$(npm root -g).
+import { createRequire } from 'node:module';
+import { mkdirSync, readFileSync } from 'node:fs';
+import { dirname, basename } from 'node:path';
+
+const require = createRequire(import.meta.url);
+export const GAME_URL = process.env.URL || 'http://127.0.0.1:5199/?debug';
+
+export async function openGame({ width = 960, height = 540 } = {}) {
+  let chromium;
+  try { ({ chromium } = require('playwright')); } catch {
+    throw new Error('Playwright was not found. Install it, or in a Claude Code cloud session run with NODE_PATH=$(npm root -g).');
+  }
+  const browser = await chromium.launch({ args: ['--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--ignore-gpu-blocklist'] });
+  const page = await browser.newPage({ viewport: { width, height } });
+  const problems = [];
+  page.on('pageerror', (e) => problems.push(e.message));
+  page.on('console', (m) => { if (m.type() === 'error') problems.push(m.text()); });
+  try { await page.goto(GAME_URL); } catch {
+    await browser.close();
+    throw new Error(`No game at ${GAME_URL}. Start one from projects/cinderdeep-3d: npx vite --port 5199 --strictPort`);
+  }
+  await page.waitForSelector('[data-go=new]');
+  await page.waitForFunction(() => !!window.__cd);
+  const ev = (fn, arg) => page.evaluate(fn, arg);
+  const until = async (fn, ms = 8000, arg) => {
+    const t = Date.now();
+    while (Date.now() - t < ms) { if (await ev(fn, arg)) return true; await page.waitForTimeout(100); }
+    return false;
+  };
+  const game = { browser, page, ev, until, problems };
+  game.close = () => browser.close();
+  return game;
+}
+
+// hide the HUD, damage numbers and menus so screenshots show only the 3D scene
+export const cleanView = ({ ev }, on = true) => ev((hide) => {
+  for (const id of ['hud', 'numbers', 'screens']) document.getElementById(id).style.visibility = hide ? 'hidden' : '';
+}, on);
+
+// through the menus like a player; ends standing in the floor's entrance, unkillable
+export async function startLife(game, heroId = 'knight') {
+  const { page, ev, until } = game;
+  await page.click('[data-go=new]');
+  await page.click(`.card[data-hero=${heroId}]`);
+  if (!(await until(() => window.__cd.G.state === 'playing' && window.__cd.G.room && window.__cd.G.room.state === 'cleared', 15000))) throw new Error('the life did not start');
+  await ev(() => window.__cd.god(true));
+}
+
+// the doors to take from the current room to the nearest room of a type (breadth first), or null
+export const route = ({ ev }, type) => ev((want) => {
+  const { G } = window.__cd;
+  const rooms = G.floorMap.rooms;
+  const prev = new Map([[G.node.id, null]]);
+  const queue = [G.node.id];
+  while (queue.length) {
+    const id = queue.shift();
+    if (rooms[id].type === want && id !== G.node.id) {
+      const path = [];
+      for (let c = id; prev.get(c); c = prev.get(c).from) path.unshift(prev.get(c).side);
+      return path;
+    }
+    for (const [side, to] of Object.entries(rooms[id].doors)) if (!prev.has(to)) { prev.set(to, { from: id, side }); queue.push(to); }
+  }
+  return null;
+}, type);
+
+// take the first card of any level-up or shrine choice that opened, so walking can go on
+export const settle = ({ ev }) => ev(() => {
+  for (let i = 0; i < 20; i++) {
+    const { G, screens } = window.__cd;
+    const top = screens.top();
+    const card = top && (G.state === 'levelup' ? top.querySelector('.card[data-pick]') : G.state === 'choice' ? top.querySelector('.card[data-opt]:not([disabled])') : null);
+    if (!card) return;
+    card.click();
+  }
+});
+
+async function clearRoom(game) {
+  const { ev, until, page } = game;
+  for (let i = 0; i < 12 && !(await ev(() => window.__cd.G.room.state === 'cleared')); i++) {
+    await until(() => window.__cd.G.enemies.length > 0 || window.__cd.G.room.state === 'cleared', 5000);
+    await ev(() => window.__cd.killAll());
+    await page.waitForTimeout(250);
+    await settle(game);
+  }
+  return until(() => window.__cd.G.room.state === 'cleared', 8000);
+}
+
+// stand on a door's threshold and wait for the next room
+async function through(game, side) {
+  const { ev, page } = game;
+  await settle(game);
+  const before = await ev(() => window.__cd.G.node.id);
+  await ev((s) => { const at = { n: [0, -10], s: [0, 10], e: [14.4, 0], w: [-14.4, 0] }[s]; window.__cd.tp(at[0], at[1]); }, side);
+  for (const t = Date.now(); Date.now() - t < 8000; await page.waitForTimeout(100)) {
+    await settle(game);
+    if (await ev((b) => window.__cd.G.node.id !== b && window.__cd.G.state === 'playing', before)) return true;
+  }
+  return false;
+}
+
+// walk to the nearest room of a type, clearing every room on the way; false if the floor has none
+export async function goTo(game, type) {
+  const path = await route(game, type);
+  if (!path) return false;
+  for (const side of path) {
+    if (!(await game.ev(() => window.__cd.G.room.state === 'cleared')) && !(await clearRoom(game))) return false;
+    if (!(await through(game, side))) return false;
+  }
+  return true;
+}
+
+export const toFloor = async (game, floor) => {
+  await settle(game);
+  await game.ev((n) => { window.__cd.toFloor(n); window.__cd.god(true); }, floor);
+  await game.until(() => window.__cd.G.state === 'playing' && window.__cd.G.node.type === 'start', 8000);
+};
+
+export async function shoot({ page }, file) {
+  mkdirSync(dirname(file), { recursive: true });
+  await page.screenshot({ path: file });
+  return file;
+}
+
+// every screenshot on one page, labelled, saved as one image
+export async function contactSheet({ browser }, files, out, { cols = 4, width = 320 } = {}) {
+  const page = await browser.newPage({ viewport: { width: cols * (width + 8) + 8, height: 200 } });
+  const cells = files.map((f) => `<figure><img src="data:image/png;base64,${readFileSync(f).toString('base64')}"><figcaption>${basename(f, '.png')}</figcaption></figure>`).join('');
+  await page.setContent(`<style>body{margin:0;padding:4px;background:#140d0a;font:12px sans-serif;color:#e8dcc8;display:grid;grid-template-columns:repeat(${cols},${width}px);gap:8px}
+    figure{margin:0}img{width:${width}px;display:block;border-radius:4px}figcaption{padding:3px 0}</style>${cells}`);
+  mkdirSync(dirname(out), { recursive: true });
+  await page.screenshot({ path: out, fullPage: true });
+  await page.close();
+  return out;
+}
