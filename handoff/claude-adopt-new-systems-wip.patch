+// Screenshot every playable body on the title pedestal, each beast in every form, and lay them out on one sheet.
+//   node gallery.mjs                 all 19 (beasts in 4 forms each)
+//   node gallery.mjs knight monk     only these
+// Output: jobs/claude-playable-characters/out/gallery/*.png and sheet.png (not committed).
+import { fileURLToPath } from 'node:url';
+import { HEROES, HERO_ORDER } from '../../../src/data/heroes.js';
+import { openGame, cleanView, shoot, contactSheet } from '../../lib/browser.mjs';
+
+const out = fileURLToPath(new URL('../out/gallery/', import.meta.url));
+const pick = process.argv.slice(2).filter((a) => HEROES[a]);
+const ids = pick.length ? pick : HERO_ORDER;
+
+const game = await openGame({ width: 600, height: 600 });
+await cleanView(game);
+// hold the title camera still, close to the pedestal and a little to the hero's right
+await game.ev(() => { window.__cd.renderer.view.orbit = { t: 1.6, speed: 0, dist: 6.2, height: 3.4, lookY: 1.5 }; });
+const files = [];
+try {
+  for (const id of ids) {
+    const forms = HEROES[id].kind === 'beast' ? [[], ['grown'], ['grown', 'apex'], ['grown', 'warden']] : [[]];
+    for (const f of forms) {
+      // bigger forms need the camera further back
+      await game.ev(([hero, fs]) => { window.__cd.renderer.view.orbit.dist = 6.2 + fs.length * 0.7; window.__cd.stage.show(hero, fs); }, [id, f]);
+      await game.page.waitForTimeout(900);
+      files.push(await shoot(game, `${out}${id}${f.length ? `-${f[f.length - 1]}` : ''}.png`));
+    }
+  }
+  console.log(`${files.length} screenshots in ${out}`);
+  console.log(`sheet: ${await contactSheet(game, files, `${out}sheet.png`, { cols: 5, width: 240 })}`);
+  if (game.problems.length) console.log(`browser errors:\n  ${game.problems.join('\n  ')}`);
+} finally {
+  await game.close();
+}
diff --git a/projects/cinderdeep-3d/jobs/claude-playable-characters/tools/roster.mjs b/projects/cinderdeep-3d/jobs/claude-playable-characters/tools/roster.mjs
