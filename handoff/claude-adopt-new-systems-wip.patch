@@ -0,0 +1,80 @@
+// Floor maps without a browser.
+//   node floors.mjs                     survey: floors 1-12 over 300 seeds, with any broken maps listed
+//   node floors.mjs --seeds 1000        a bigger survey
+//   node floors.mjs --map 7 --seed 42   draw floor 7 for seed 42
+import { generateFloor, ROOM_INFO, GRID, isBossFloor } from '../../../src/game/floor.js';
+import { regionForFloor } from '../../../src/data/regions.js';
+
+const args = process.argv.slice(2);
+const opt = (name, d) => { const i = args.indexOf(name); return i >= 0 ? Number(args[i + 1]) : d; };
+const LETTER = { start: 'S', combat: 'c', elite: 'E', exit: 'X', boss: 'B', treasure: 'T', shop: '$', rest: 'R', shrine: '+' };
+
+function draw(map) {
+  const at = new Map(map.rooms.map((r) => [`${r.gx},${r.gy}`, r]));
+  const lines = [];
+  for (let y = 0; y < GRID; y++) {
+    let row = '';
+    let below = '';
+    for (let x = 0; x < GRID; x++) {
+      const r = at.get(`${x},${y}`);
+      row += r ? `[${LETTER[r.type] || '?'}${r.locked ? '*' : ' '}]` : '    ';
+      row += r && r.doors.e !== undefined ? '-' : ' ';
+      below += r && r.doors.s !== undefined ? ' |   ' : '     ';
+    }
+    lines.push(row.trimEnd(), below.trimEnd());
+  }
+  while (lines.length && !lines[0]) lines.shift();
+  while (lines.length && !lines[lines.length - 1]) lines.pop();
+  return lines.join('\n');
+}
+
+// what must hold for every floor: everything reachable, one way down, fair keys
+function problems(map, floor) {
+  const out = [];
+  const seen = new Set([map.startId]);
+  const queue = [map.startId];
+  while (queue.length) for (const id of Object.values(map.rooms[queue.shift()].doors)) if (!seen.has(id)) { seen.add(id); queue.push(id); }
+  if (seen.size !== map.rooms.length) out.push(`${map.rooms.length - seen.size} room(s) unreachable`);
+  const down = map.rooms.filter((r) => r.type === (isBossFloor(floor) ? 'boss' : 'exit')).length;
+  if (down !== 1) out.push(`${down} ${isBossFloor(floor) ? 'boss' : 'exit'} rooms`);
+  if (map.rooms.some((r) => r.locked) && !map.rooms.some((r) => r.dropsKey)) out.push('locked treasure with no key');
+  for (const r of map.rooms) for (const [side, id] of Object.entries(r.doors)) {
+    const back = { n: 's', s: 'n', e: 'w', w: 'e' }[side];
+    if (map.rooms[id].doors[back] !== r.id) out.push(`door ${r.id}->${id} has no way back`);
+  }
+  return out;
+}
+
+const mapFloor = opt('--map', 0);
+if (mapFloor) {
+  const seed = opt('--seed', 1);
+  const map = generateFloor(mapFloor, seed);
+  console.log(`Floor ${mapFloor} (${regionForFloor(mapFloor).name}), seed ${seed}: ${map.rooms.length} rooms\n`);
+  console.log(draw(map));
+  console.log(`\n${Object.entries(LETTER).map(([t, l]) => `${l} ${ROOM_INFO[t]?.label || t}`).join('  ')}  * locked`);
+  const bad = problems(map, mapFloor);
+  console.log(bad.length ? `\nPROBLEMS: ${bad.join('; ')}` : '\nno problems');
+  process.exit(bad.length ? 1 : 0);
+}
+
+const seeds = opt('--seeds', 300);
+let broken = 0;
+const rows = [];
+for (let floor = 1; floor <= 12; floor++) {
+  const sizes = [];
+  const types = {};
+  for (let seed = 1; seed <= seeds; seed++) {
+    let map;
+    try { map = generateFloor(floor, seed); } catch (e) { console.log(`floor ${floor} seed ${seed}: ${e.message}`); broken++; continue; }
+    sizes.push(map.rooms.length);
+    for (const r of map.rooms) types[r.type] = (types[r.type] || 0) + 1;
+    const bad = problems(map, floor);
+    if (bad.length) { broken++; if (broken <= 20) console.log(`floor ${floor} seed ${seed}: ${bad.join('; ')}`); }
+  }
+  const avg = (n) => (n / sizes.length).toFixed(1);
+  rows.push(`${String(floor).padStart(2)}  ${regionForFloor(floor).name.padEnd(16)} rooms ${Math.min(...sizes)}-${Math.max(...sizes)} (avg ${avg(sizes.reduce((a, b) => a + b, 0))})  ` +
+    Object.keys(LETTER).filter((t) => types[t]).map((t) => `${LETTER[t]} ${avg(types[t])}`).join('  '));
+}
+console.log(`Floors 1-12 over ${seeds} seeds (room-type counts are per floor, on average):\n${rows.join('\n')}`);
+console.log(broken ? `\n${broken} broken floor(s)` : '\nevery floor is connected, has one way down and fair keys');
+process.exit(broken ? 1 : 0);
diff --git a/projects/cinderdeep-3d/jobs/chatgpt-world/tools/regions.mjs b/projects/cinderdeep-3d/jobs/chatgpt-world/tools/regions.mjs
