+// Spawn every enemy in front of the hero and screenshot it, optionally as an elite and with the bosses.
+//   node gallery.mjs                  every enemy
+//   node gallery.mjs yeti golem       only these
+//   node gallery.mjs --elite          as elites
+//   node gallery.mjs --bosses         the four bosses (walks to each boss room)
+// Output: jobs/other-claude-enemies-and-assets/out/gallery/*.png and sheet.png (not committed).
+import { fileURLToPath } from 'node:url';
+import { ENEMIES } from '../../../src/data/enemies.js';
+import { REGIONS } from '../../../src/data/regions.js';
+import { openGame, cleanView, startLife, toFloor, goTo, shoot, contactSheet } from '../../lib/browser.mjs';
+
+const out = fileURLToPath(new URL('../out/gallery/', import.meta.url));
+const args = process.argv.slice(2);
+const elite = args.includes('--elite');
+const pick = args.filter((a) => ENEMIES[a]);
+const kinds = args.includes('--bosses') && !pick.length ? [] : pick.length ? pick : Object.keys(ENEMIES);
+
+const game = await openGame();
+const files = [];
+try {
+  await startLife(game);
+  await cleanView(game);
+  for (const kind of kinds) {
+    // clear the last one away without a kill, so no rewards or level-ups get in the way
+    await game.ev(() => { window.__cd.G.enemies.length = 0; window.__cd.G.projectiles.length = 0; });
+    await game.ev(([k, el]) => { const p = window.__cd.G.player; window.__cd.spawn(k, p.x, p.z - 3.2, el); }, [kind, elite]);
+    // let it rise from its spawn column, then hold the frame still
+    await game.until(() => window.__cd.G.enemies.some((e) => e.state !== 'spawn'), 4000);
+    await game.page.waitForTimeout(500);
+    await game.ev(() => window.__cd.game.pause());
+    await game.page.waitForTimeout(150);
+    files.push(await shoot(game, `${out}${kind}${elite ? '-elite' : ''}.png`));
+    await game.ev(() => window.__cd.game.resume());
+  }
+  if (args.includes('--bosses')) {
+    for (const [i, region] of REGIONS.entries()) {
+      await toFloor(game, i * 3 + 3);
+      if (!(await goTo(game, 'boss'))) { console.log(`${region.id}: no boss room`); continue; }
+      await game.until(() => window.__cd.G.state === 'cinematic', 10000);
+      await game.page.waitForTimeout(1500);
+      files.push(await shoot(game, `${out}boss-${region.boss}.png`));
+    }
+  }
+  console.log(`${files.length} screenshots in ${out}`);
+  if (files.length) console.log(`sheet: ${await contactSheet(game, files, `${out}sheet.png`, { cols: 5, width: 256 })}`);
+  if (game.problems.length) console.log(`browser errors:\n  ${game.problems.join('\n  ')}`);
+} finally {
+  await game.close();
+}
