@@ -0,0 +1,40 @@
+// Walk each region's rooms in a real browser and screenshot every room type, then lay them out on one sheet.
+//   node regions.mjs                 all four regions
+//   node regions.mjs frostvault      one region (ossuary, grotto, frostvault, cindercore)
+// Output: jobs/chatgpt-world/out/regions/<region>-<room>.png and sheet.png (not committed).
+import { fileURLToPath } from 'node:url';
+import { REGIONS } from '../../../src/data/regions.js';
+import { openGame, cleanView, startLife, toFloor, goTo, settle, shoot, contactSheet } from '../../lib/browser.mjs';
+
+const out = fileURLToPath(new URL('../out/regions/', import.meta.url));
+const pick = process.argv.slice(2);
+const regions = REGIONS.map((r, i) => ({ ...r, first: i * 3 + 1, bossFloor: i * 3 + 3 })).filter((r) => !pick.length || pick.includes(r.id));
+const ROOMS = ['combat', 'elite', 'treasure', 'shop', 'rest', 'shrine', 'exit'];
+
+const game = await openGame();
+const files = [];
+const snap = async (name) => {
+  await game.page.waitForTimeout(1200);
+  await settle(game);
+  files.push(await shoot(game, `${out}${name}.png`));
+};
+try {
+  await startLife(game);
+  await cleanView(game);
+  for (const r of regions) {
+    // the region's second floor has every room type (the first floor of the descent has no elite or shrine)
+    await toFloor(game, r.first + 1);
+    await snap(`${r.id}-start`);
+    for (const type of ROOMS) {
+      if (!(await goTo(game, type))) { console.log(`${r.id}: no ${type} room on floor ${r.first + 1}`); continue; }
+      await snap(`${r.id}-${type}`);
+    }
+    await toFloor(game, r.bossFloor);
+    if (await goTo(game, 'boss')) await snap(`${r.id}-boss`);
+  }
+  console.log(`${files.length} screenshots in ${out}`);
+  console.log(`sheet: ${await contactSheet(game, files, `${out}sheet.png`, { cols: 4, width: 320 })}`);
+  if (game.problems.length) console.log(`browser errors:\n  ${game.problems.join('\n  ')}`);
+} finally {
+  await game.close();
+}
