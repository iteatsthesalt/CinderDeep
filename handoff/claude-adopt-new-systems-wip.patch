+// Every playable at a glance: stats, weapon, ability and passive, plus which ability kinds are still shared.
+//   node roster.mjs              the whole roster
+//   node roster.mjs --hero monk  one playable's stat sheet at levels 1, 5 and 12 (and each beast form)
+import { HEROES, HERO_ORDER, FINAL_FORMS } from '../../../src/data/heroes.js';
+import { WEAPONS } from '../../../src/data/weapons.js';
+import { ABILITIES } from '../../../src/data/abilities.js';
+import { computeStats } from '../../../src/game/stats.js';
+
+const args = process.argv.slice(2);
+const pct = (v) => `${Math.round(v * 100)}%`;
+const table = (rows) => {
+  const w = rows[0].map((_, i) => Math.max(...rows.map((r) => String(r[i]).length)));
+  for (const r of rows) console.log(r.map((c, i) => String(c).padEnd(w[i])).join('  '));
+};
+
+const heroArg = args.indexOf('--hero');
+if (heroArg >= 0) {
+  const h = HEROES[args[heroArg + 1]];
+  if (!h) { console.log(`No playable "${args[heroArg + 1]}". Ids: ${HERO_ORDER.join(', ')}`); process.exit(1); }
+  const w = WEAPONS[h.weapon];
+  const a = ABILITIES[h.ability];
+  console.log(`${h.name} (${h.kind}${h.element ? `, ${h.element}` : ''}): ${h.blurb}`);
+  console.log(`Passive: ${h.passiveText}`);
+  console.log(`Weapon: ${w.name}, ${w.kind} ${w.anim}, ${w.damage} damage every ${w.cooldown}s`);
+  console.log(`Ability: ${a.name} (${a.kind}), ${a.cooldown}s cooldown, power ${a.power}\n`);
+  const builds = [[1, []], [5, h.kind === 'beast' ? ['grown'] : []], [12, h.kind === 'beast' ? ['grown'] : []]];
+  if (h.kind === 'beast') for (const f of FINAL_FORMS) builds.push([12, ['grown', f]]);
+  const rows = [['level', 'forms', 'health', 'speed', 'armor', 'crit', 'crit x', 'damage x', 'dashes', 'flasks']];
+  for (const [level, forms] of builds) {
+    const s = computeStats(h, { level, ranks: {}, relics: [], forms }, ['core']);
+    rows.push([level, forms.join('+') || '-', s.maxHp, s.speed.toFixed(2), pct(s.armor), pct(s.crit), s.critMul.toFixed(2), s.damageMul.toFixed(2), s.dashes, s.potionMax]);
+  }
+  table(rows);
+  console.log('\n(Atlas: Ember Heart only; no level-up passives or relics.)');
+  process.exit(0);
+}
+
+const rows = [['id', 'kind', 'health', 'speed', 'armor', 'crit', 'weapon', 'style', 'ability', 'kind', 'passive']];
+for (const id of HERO_ORDER) {
+  const h = HEROES[id];
+  const w = WEAPONS[h.weapon];
+  const a = ABILITIES[h.ability];
+  rows.push([id, h.kind === 'beast' ? h.element : 'hero', h.base.maxHp, h.base.speed, pct(h.base.armor), pct(h.base.crit), w.name, w.anim, a.name, a.kind, h.passiveText]);
+}
+table(rows);
+
+const byAbility = {};
+for (const id of HERO_ORDER) (byAbility[HEROES[id].ability] ||= []).push(id);
+const shared = Object.entries(byAbility).filter(([, ids]) => ids.length > 1);
+console.log(`\n${HERO_ORDER.length} playables, ${Object.keys(WEAPONS).length} weapons, ${Object.keys(ABILITIES).length} abilities.`);
+if (shared.length) {
+  console.log('Abilities still shared by more than one playable (see "Next up" for the signature ones):');
+  for (const [ab, ids] of shared) console.log(`  ${ABILITIES[ab].name}: ${ids.join(', ')}`);
+}
diff --git a/projects/cinderdeep-3d/jobs/lib/browser.mjs b/projects/cinderdeep-3d/jobs/lib/browser.mjs
