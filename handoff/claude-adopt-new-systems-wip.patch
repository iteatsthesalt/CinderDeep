+  const w = rows[0].map((_, i) => Math.max(...rows.map((r) => String(r[i]).length)));
+  for (const r of rows) console.log(`  ${r.map((c, i) => String(c).padEnd(w[i])).join('  ')}`);
+};
+const plain = (o) => JSON.stringify(o, (k, v) => (typeof v === 'function' ? '[function]' : v), 2);
+
+const one = (flag, set) => { const i = args.indexOf(flag); return i >= 0 ? [args[i + 1], set[args[i + 1]]] : null; };
+const enemy = one('--enemy', ENEMIES);
+if (enemy) { console.log(enemy[1] ? plain(enemy[1]) : `No enemy "${enemy[0]}". Ids: ${Object.keys(ENEMIES).join(', ')}`); process.exit(enemy[1] ? 0 : 1); }
+const boss = one('--boss', BOSSES);
+if (boss) {
+  const b = boss[1];
+  if (!b) { console.log(`No boss "${boss[0]}". Ids: ${Object.keys(BOSSES).join(', ')}`); process.exit(1); }
+  console.log(`${b.name}, ${b.title}: ${b.hp} health, ${b.damage} damage, minions ${b.minion.join(', ')}`);
+  for (let phase = 0; phase <= 2; phase++) console.log(`  phase ${phase + 1}: ${b.moves.filter((m) => (m.minPhase || 0) <= phase).map((m) => `${m.id} (${m.type})`).join(', ')}`);
+  process.exit(0);
+}
+
